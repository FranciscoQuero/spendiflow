    "@react-navigation/native-stack": "^7.11.0",
    "expo": "~54.0.32",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "^14.0.11",
    "expo-haptics": "^15.0.8",
    "expo-localization": "^17.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "i18n-js": "^4.5.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
