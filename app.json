{
  "expo": {
    "name": "Spendiflow",
    "slug": "spendiflow",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F5FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendiflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F5FA"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.spendiflow.app",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "0739be1a-0c5d-482c-9ddf-a475c97ef0f3"
      }
    },
    "owner": "11ideas"
  }
}
